{
  "manifest_version": 3,
  "name": "Kestrel bridge",
  "version": "0.1.0",
  "description": "Shows Kestrel logins on a login form and fills them only after you confirm the item and origin.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@kestrel",
      "strict_min_version": "109.0"
    }
  }
}
